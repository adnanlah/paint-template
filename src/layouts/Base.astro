---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";

interface Props {
	title: string;
	mainClass?: string;
}

const { title, mainClass } = Astro.props;
---

<Layout title={title}>
	<div class="container">
		<Header />
		<main class:list={["wrapper", mainClass]}>
			<slot />
		</main>
		<div class="footer-row wrapper">
			<Footer />
		</div>
	</div>
</Layout>

<style>
	.container {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr) auto;
		min-height: 100vh;
	}

	main {
		min-height: 0;
	}

	main.compact-page {
		display: flex;
		flex-direction: column;
	}

	.footer-row {
		align-self: end;
	}

	@media screen and (max-width: 768px) {
		main.compact-page {
			display: block;
		}
	}
</style>
