---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://cdn.sanity.io" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>El Bahi Belkheiri - {title}</title>
		<script is:inline>
			const analyticsId = "G-JBFSPQRVTD";

			function loadAnalytics() {
				if (window.__analyticsLoaded) return;

				window.__analyticsLoaded = true;
				window.dataLayer = window.dataLayer || [];
				window.gtag = function gtag() {
					window.dataLayer.push(arguments);
				};
				window.gtag("js", new Date());
				window.gtag("config", analyticsId);

				const script = document.createElement("script");
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
				document.head.append(script);
			}

			function scheduleAnalytics() {
				if ("requestIdleCallback" in window) {
					window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
					return;
				}

				window.setTimeout(loadAnalytics, 1500);
			}

			if (document.readyState === "complete") {
				scheduleAnalytics();
			} else {
				window.addEventListener("load", scheduleAnalytics, { once: true });
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primary-color: #000;
		--secondary-color: #777777;
		--background-color: #fcfcfc;
	}

	html,
	body {
		font-family: "Raleway", sans-serif;
		font-optical-sizing: auto;
		min-height: 100vh;
		font-size: 14px;
		font-weight: 400;
		margin: 0;
		padding: 0;
		width: 100%;
		background: var(--background-color);
		/* overflow-x: hidden; */
	}

	a,
	a:visited,
	a:active {
		color: inherit;
		text-decoration: none;
		position: relative;
	}

	a.styledLink {
		color: var(--secondary-color);
	}

	a.styledLink.active,
	a.styledLink:hover {
		color: #000 !important;
		text-shadow: 0 0 0.5px currentColor;
	}

	a.styledImage {
		display: block;
		overflow: hidden;
		border-radius: inherit;
		/* Needed for iOS safari clipping */
		-webkit-mask-image: -webkit-radial-gradient(white, black);
	}

	a.styledImage img {
		display: block;
		width: 100%;
		height: auto;
		overflow: hidden !important;
		transition: transform 0.3s ease-in-out;
	}

	a.styledImage:hover img {
		transform: scale(1.02);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		margin: 0;
		padding: 0;
	}

	p {
		margin: 0;
		padding: 0;
	}

	.red {
		color: red;
	}

	.clickableImage {
		transition: transform 0.3s ease-in-out;
	}

	.clickableImage.left:hover {
		transform: translateX(-0.5rem);
	}

	.clickableImage.right:hover {
		transform: translateX(0.5rem);
	}

	.wrapper {
		padding: 0 10rem;
		max-width: 2400px;
	}

	@media screen and (max-width: 1200px) {
		.wrapper {
			padding: 0 5rem;
		}
	}

	@media screen and (max-width: 768px) {
		html,
		body {
			font-size: 12px;
		}

		.wrapper {
			padding: 0 2.5rem;
		}
	}
</style>
