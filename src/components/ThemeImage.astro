---
import ResponsiveSanityImage from "./ResponsiveSanityImage.astro";
import type { SanityImageWithMetadata } from "../scripts/helpers";

interface Props {
    title: string;
    url: string;
    image: SanityImageWithMetadata;
    width: number;
    height: number;
    loading?: "eager" | "lazy";
    fetchpriority?: "auto" | "high" | "low";
}

const { title, url, image, width, height, loading, fetchpriority } = Astro.props;
---

<div class={"artwork"}>
    <a href={url} class="styledImage">
        <ResponsiveSanityImage
            source={image}
            alt={title}
            sourceWidth={width}
            sourceHeight={height}
            widths={[240, 360, 480, 640, 800, 1000]}
            sizes="(max-width: 768px) 40vw, 30vw"
            loading={loading}
            fetchpriority={fetchpriority}
            class="image"
        />
    </a>
    <div class="info">
        <a href={url}>
            <h2>{title}</h2>
        </a>
        <slot />
    </div>
</div>

<style>
    .artwork {
        width: 100%;
        display: grid;
        grid-template-columns: 40% 1fr;
        align-items: end;
        gap: 2.5rem;
    }

    .artwork .image {
        width: 100%;
        height: auto;
    }

    .artwork .info {
        display: flex;
        flex-direction: column;
        justify-self: stretch;
        gap: 1rem;
    }

    @media screen and (max-width: 768px) {
        .artwork {
            gap: 1rem;
        }

        .artwork .info {
            gap: 0.5rem;
        }
    }
</style>
