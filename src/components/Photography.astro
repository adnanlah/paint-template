---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { urlFor } from "../scripts/helpers";

const QUERY = `*[
  _type == "photography" && highlighted == true
]|order(year desc)[0..1]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const photography = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
    <a href="/photography" class:list={["styledLink", "title"]}>PHOTOGRAPHY</a>
    <div>
        <a href="/photography" class:list={["row", "clickableImage", "left"]}>
            {
                photography.map((photo, idx) => (
                    <Image
                        src={urlFor(photo.image.asset.url)
                            .width(800)
                            .format("webp")
                            .url()}
                        alt={photo.title}
                        width={800}
                        height={Math.round(
                            (photo.image.asset.metadata.dimensions.height /
                                photo.image.asset.metadata.dimensions.width) *
                                800,
                        )}
                        class={"photography"}
                        style={{ marginTop: 1 * idx + "rem" }}
                    />
                ))
            }
        </a>
    </div>
</div>

<style>
    .container {
        margin-top: 7rem;
    }

    .title {
        font-size: 2rem;
        font-weight: bold;
        margin-left: 7rem;
    }

    .row {
        margin-top: 5rem;
        display: inline-flex;
        flex-direction: row;
        justify-content: flex-start;
        align-items: start;
        gap: 2.5rem;
        overflow: visible;
        width: 80%;
    }

    .photography {
        display: block;
        width: 50%;
        height: auto;
    }
</style>
