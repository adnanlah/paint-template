---
import InquireForm from "./InquireForm.astro";

const { id, slug } = Astro.props;
---

<dialog id={id}>
    <div class="modal-content">
        <div class="modal-header">
            <div class="modal-title">Inquire about this artwork</div>
            <button id="close-modal">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="size-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18 18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <InquireForm slug={slug} />
    </div>
</dialog>

<style>
    dialog {
        padding: 0;
        border: none;
        border-radius: 1rem;
        max-width: 40rem;
        width: 90%;
        box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
    }

    .modal-header button svg {
        width: 1.5rem;
        height: 1.5rem;
    }

    .modal-header button {
        background: transparent;
        border: none;
        padding: 0.1rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.375rem;
        color: black;
    }

    dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(2px);
    }

    .modal-content {
        padding: 5rem;
    }

    .modal-title {
        font-size: 1.2rem;
        font-weight: 600;
    }

    dialog[open] {
        animation: fade-in 0.2s ease;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>
