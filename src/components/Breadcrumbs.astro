---
import Chevron from "./Chevron.astro";

interface Props {
    links: {
        label: string;
        href: string;
    }[];
    current?: string;
}

const { links, current } = Astro.props;
---

<h1 class="breadcrumbs">
    {
        links.map((link, index) => (
            <>
                <a href={link.href}>{link.label}</a>
                {(index < links.length - 1 || current) && <Chevron />}
            </>
        ))
    }
    {current && <span>{current}</span>}
</h1>

<style>
    .breadcrumbs {
        display: flex;
        align-items: center;
        font-weight: 400 !important;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .breadcrumbs a {
        color: var(--secondary-color);
    }

    .breadcrumbs a:hover {
        color: #000 !important;
    }

    @media screen and (max-width: 768px) {
        .breadcrumbs {
            font-size: 1.5rem;
        }
    }
</style>
