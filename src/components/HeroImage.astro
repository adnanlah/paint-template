---
import { Image } from "astro:assets";
import tuareg from "../assets/tuareg.png";
import img1 from "../assets/gallery/photo_2026-02-07 22.30.02.jpeg";
import img2 from "../assets/gallery/photo_2026-02-07 22.29.52.jpeg";
import img3 from "../assets/gallery/photo_2026-02-07 22.30.00.jpeg";
import img4 from "../assets/gallery/photo_2026-02-07 22.29.29.jpeg";
---

<section class={"gallerySection"}>
  <div class={"galleryContainer"}>
    <div class={"galleryRow"}>
      <Image src={tuareg} alt="Image 1" class={"painting"} />
      <!-- <Image src={img2} alt="Image 2" class={styles.painting} />
      <Image src={img3} alt="Image 3" class={styles.painting} />
      <Image src={img4} alt="Image 4" class={styles.painting} /> -->
    </div>
  </div>
</section>

<style>
  .gallerySection {
    width: 100%;
  }

  .galleryContainer {
    padding: 0 7rem;
    overflow: hidden;
  }

  .galleryContainer::-webkit-scrollbar {
    height: 8px;
  }

  .galleryContainer::-webkit-scrollbar-track {
    background: transparent;
  }

  .galleryContainer::-webkit-scrollbar-thumb {
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.2);
  }

  .galleryRow {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-width: 100%;
    overflow: visible;
  }

  .galleryItem {
    flex-shrink: 0;
    background: #82181a;
    padding: 12px;
    box-shadow:
      0 10px 20px rgba(0, 0, 0, 0.06),
      0 4px 6px rgba(0, 0, 0, 0.04),
      inset 0 0 0 1px rgba(0, 0, 0, 0.03);
    transition:
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.4s ease;
  }

  .painting {
    display: block;
    width: auto;
    height: auto;
    max-height: 30rem;
  }
</style>
