---
const currentPath = Astro.url.pathname;
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const QUERY = `*[
  _type == "bio"
]|{_id, email, address, instagram, facebook, body, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const bio = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
    <a href="/" class={"logoContainer"} aria-label="Home"></a>
    <div class={"nav"}>
        <a href="/" class:list={["styledLink", { active: currentPath === "/" }]}
            >Home</a
        >
        <a
            href="/artwork"
            class:list={[
                "styledLink",
                { active: currentPath.startsWith("/artwork") },
            ]}>Artwork</a
        >
        <a
            href="/about"
            class:list={["styledLink", { active: currentPath === "/about" }]}
            >About</a
        >
        <a
            href="/contact-me"
            class:list={["styledLink", { active: currentPath === "/contact" }]}
            >Contact</a
        >
        <a
            href={bio[0].instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="icon"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"
                ></rect><path
                    d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"
                ></line></svg
            >
        </a>
    </div>
</div>

<style>
    .container {
        font-size: 1rem;
        padding: 5rem 7.5rem 2.5rem 7.5rem;
        font-weight: 500;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    a.logoContainer {
        display: block;
        width: 7.25rem;
        aspect-ratio: 797 / 368;
        background-image: url("/logo.svg");
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center;
    }

    a.logoContainer::after {
        display: none;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 2rem;
        justify-self: start;
    }

    .nav .icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        background-color: transparent;
        color: currentColor;
        transition:
            background-color 0.3s ease,
            color 0.3s ease,
            transform 0.3s ease;
    }

    .nav .icon::after {
        display: none;
    }

    .nav .icon:hover {
        background-color: #000;
        color: #fff;
    }
</style>
