---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import InstagramIcon from "./icons/InstagramIcon.astro";

const QUERY = `*[
  _type == "about"
]|{instagram}`;

const about = await sanityClient.fetch<SanityDocument[]>(QUERY);

const rawPath = Astro.url.pathname;
const currentPath =
    rawPath.endsWith("/") && rawPath !== "/" ? rawPath.slice(0, -1) : rawPath;
---

<div class:list={["container", "wrapper"]}>
    <a href="/" class={"logoContainer"} aria-label="Home"></a>
    <div class={"nav"}>
        <a
            href="/"
            class:list={[
                "styledLink",
                {
                    active:
                        currentPath === "/" ||
                        currentPath.startsWith("/paintings") ||
                        currentPath.startsWith("/digital-collages") ||
                        currentPath.startsWith("/photography"),
                },
            ]}>ARTWORK</a
        >
        <a
            href="/about"
            class:list={["styledLink", { active: currentPath === "/about" }]}
            >ABOUT</a
        >
        <a
            href="/contact"
            class:list={["styledLink", { active: currentPath === "/contact" }]}
            >CONTACT</a
        >
        <a
            href={about[0].instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class:list={["styledLink", "icon"]}
        >
            <InstagramIcon />
        </a>
    </div>
</div>

<style>
    .container {
        font-size: 1rem;
        margin: 5rem 0 2.5rem;
        font-weight: 500;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    a.logoContainer {
        display: block;
        width: 7.5rem;
        min-width: 7.5rem;
        aspect-ratio: 797 / 368;
        background-image: url("/logo.svg");
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center;
        transition: background-color 0.3s ease;
    }

    @supports (-webkit-mask-image: url("/logo.svg")) or
        (mask-image: url("/logo.svg")) {
        a.logoContainer {
            background-color: #000;
            background-image: none;
            -webkit-mask-image: url("/logo.svg");
            mask-image: url("/logo.svg");
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-size: contain;
            mask-size: contain;
            -webkit-mask-position: center;
            mask-position: center;
        }

        a.logoContainer:hover {
            background-color: var(--secondary-color);
        }
    }

    a.logoContainer::after {
        display: none;
    }

    .nav {
        display: flex;
        align-items: center;
        gap: 2rem;
        justify-self: start;
        color: var(--secondary-color);
    }

    .nav a {
        color: inherit;
    }

    .nav .icon {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: transparent;
        color: currentColor;
        width: 2rem;
        height: 2rem;
    }

    @media screen and (max-width: 768px) {
        .nav {
            gap: 1rem;
        }
    }
</style>
