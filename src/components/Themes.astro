---
import ResponsiveSanityImage from "./ResponsiveSanityImage.astro";
import type { ThemeCard } from "../scripts/helpers";

const { themes } = Astro.props as {
    themes: ThemeCard[];
};
---

<div class={"container"}>
    {
        themes.map((theme, index) => (
            <div class:list={["theme"]}>
                <a
                    href={theme.url}
                    class:list={["image-container", "styledImage"]}
                >
                    <ResponsiveSanityImage
                        source={theme.image.source}
                        alt={theme.title}
                        sourceWidth={theme.image.width}
                        sourceHeight={theme.image.height}
                        widths={[240, 360, 480, 640, 800, 1000]}
                        sizes="(max-width: 768px) calc((100vw - 7.5rem) / 2), 25vw"
                        cropSquare
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                    />
                </a>

                <div class={"info"}>
                    <a href={theme.url} class={"styledLink"}>
                        {theme.title}
                    </a>
                </div>
            </div>
        ))
    }
</div>

<style>
    .container {
        margin-top: 2.5rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5rem;
    }

    .theme {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .theme .image-container {
        display: block;
        width: 100%;
    }

    .theme .image-container img {
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-fit: cover;
    }

    .theme .info {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        text-transform: uppercase;
    }

    @media screen and (max-width: 768px) {
        .container {
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
        }
    }
</style>
