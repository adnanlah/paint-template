---
import { Image } from "astro:assets";
import img1 from "../assets/gallery/photo_2026-02-07 22.30.02.jpeg";
import img2 from "../assets/gallery/photo_2026-02-07 22.29.52.jpeg";
import img3 from "../assets/gallery/photo_2026-02-07 22.30.00.jpeg";
---

<div class={"container"}>
  <a href="/paintings" class:list={["styledLink", "title"]}>PAINTINGS</a>
  <div>
    <a href="/paintings" class={"row"}>
      <Image src={img1} alt="Image 1" class={"painting"} />
      <Image src={img2} alt="Image 2" class={"painting"} />
      <Image src={img3} alt="Image 3" class={"painting"} />
    </a>
  </div>
</div>

<style>
  .container {
    margin-top: 7rem;
  }

  .title {
    font-size: 2rem;
    font-weight: bold;
    margin-left: 7rem;
  }

  .row {
    margin-top: 5rem;
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 2rem;
    overflow: visible;
  }

  .painting {
    display: block;
    border-radius: 4px;
    width: auto;
    height: auto;
    max-height: 25rem;
  }
</style>
