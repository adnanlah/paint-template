---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { urlFor } from "../scripts/helpers";

const QUERY = `*[
  _type == "painting"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, width, height, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const paintings = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
  <a href="/paintings" class:list={["styledLink", "title"]}>PAINTINGS</a>
  <div>
    <a href="/paintings" class:list={["row", "clickableImage", "left"]}>
      {
        paintings.map((painting) => (
          <Image
            src={urlFor(painting.image.asset.url).width(600).url()}
            alt={painting.title}
            width={painting.image.asset.metadata.dimensions.width}
            height={painting.image.asset.metadata.dimensions.height}
            class={"painting"}
          />
        ))
      }
    </a>
  </div>
</div>

<style>
  .container {
    margin-top: 7rem;
  }

  .title {
    font-size: 2rem;
    font-weight: bold;
    margin-left: 7rem;
  }

  .row {
    margin-top: 5rem;
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 2.5rem;
    overflow: visible;
  }

  .painting {
    display: block;
    width: auto;
    height: 25rem;
  }
</style>
