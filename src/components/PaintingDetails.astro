---
import Dimensions from "./Dimensions.astro";

interface Props {
    painting: {
        year: string;
        width: number;
        height: number;
        medium: string;
    };
}

const { painting } = Astro.props;
---

<div class="details">
    <div class="dim">
        <b>Dimensions:</b>
        <Dimensions width={painting.width} height={painting.height} />
    </div>
    <div><b>Medium:</b> {painting.medium}</div>
    <div><b>Year:</b> {painting.year}</div>
</div>

<style>
    .details {
        display: flex;
        flex-direction: column;
        align-items: left;
        gap: 0.5rem;
    }

    .dim {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>
