---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { urlFor } from "../scripts/helpers";

const QUERY = `*[
  _type == "collage"
  && highlighted == true
]|order(year desc)[0..1]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const collages = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
  <a href="/collages" class:list={["styledLink", "title"]}>DIGITAL COLLAGES</a>
  <div class="collages-container">
    <a href="/collages" class:list={["row", "clickableImage", "right"]}>
      {
        collages.map((collage) => (
          <Image
            src={urlFor(collage.image.asset.url).width(600).url()}
            alt={collage.title}
            width={collage.image.asset.metadata.dimensions.width}
            height={collage.image.asset.metadata.dimensions.height}
            class={"collage"}
          />
        ))
      }
    </a>
  </div>
</div>

<style>
  .container {
    margin-top: 7rem;
  }

  .title {
    font-size: 2rem;
    font-weight: bold;
    margin-left: 7rem;
  }

  .collages-container {
    display: flex;
    justify-content: flex-end;
  }

  .row {
    margin-top: 5rem;
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 2.5rem;
    overflow: visible;
  }

  .collage {
    display: block;
    width: auto;
    height: 35rem;
  }
</style>
