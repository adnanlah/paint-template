---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { urlFor } from "../scripts/helpers";

const QUERY = `*[
  _type == "collage"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const collages = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
  <a href="/digital-collages" class:list={["styledLink", "title"]}
    >DIGITAL COLLAGES</a
  >
  <div class="collages-container">
    <a href="/digital-collages" class:list={["row", "clickableImage", "right"]}>
      {
        collages.map((collage) => (
          <Image
            src={urlFor(collage.image.asset.url)
              .width(600)
              .format("webp")
              .url()}
            alt={collage.title}
            width={600}
            height={Math.round(
              (collage.image.asset.metadata.dimensions.height /
                collage.image.asset.metadata.dimensions.width) *
                600,
            )}
            class={"collage"}
          />
        ))
      }
    </a>
  </div>
</div>

<style>
  .container {
    margin-top: 7rem;
  }

  .title {
    font-size: 2rem;
    font-weight: bold;
    margin-left: 7rem;
  }

  .collages-container {
    display: flex;
    justify-content: flex-end;
  }

  .row {
    margin-top: 5rem;
    display: inline-flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: start;
    gap: 2.5rem;
    overflow: visible;
    width: 66%;
  }

  .collage {
    display: block;
    width: 33%;
    height: auto;
  }
</style>
