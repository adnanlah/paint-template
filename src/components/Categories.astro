---
import { sanityClient } from "sanity:client";
import ResponsiveSanityImage from "./ResponsiveSanityImage.astro";
import type { HighlightedArtworkDocument } from "../scripts/helpers";

const QUERY1 = `*[
  _type == "painting"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const paintings = await sanityClient.fetch<HighlightedArtworkDocument[]>(
  QUERY1,
);

const QUERY2 = `*[
  _type == "collage"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const collages = await sanityClient.fetch<HighlightedArtworkDocument[]>(
  QUERY2,
);

const QUERY3 = `*[
  _type == "photography"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const photography = await sanityClient.fetch<HighlightedArtworkDocument[]>(
  QUERY3,
);
---

<section class={"container"}>
  <div class="type">
    <a href="/paintings" class="styledImage">
      {paintings?.[0]?.image ? (
        <ResponsiveSanityImage
          source={paintings[0].image}
          alt={paintings[0].title}
          sourceWidth={paintings[0].image.asset.metadata.dimensions.width}
          sourceHeight={paintings[0].image.asset.metadata.dimensions.height}
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 768px) calc(100vw - 5rem), 30vw"
          cropSquare
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/paintings" class="styledLink">PAINTING</a>
    </div>
  </div>
  <div class="type">
    <a href="/digital-collages" class="styledImage">
      {collages?.[0]?.image ? (
        <ResponsiveSanityImage
          source={collages[0].image}
          alt={collages[0].title}
          sourceWidth={collages[0].image.asset.metadata.dimensions.width}
          sourceHeight={collages[0].image.asset.metadata.dimensions.height}
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 768px) calc(100vw - 5rem), 30vw"
          cropSquare
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/digital-collages" class="styledLink">DIGITAL COLLAGES</a>
    </div>
  </div>
  <div class="type">
    <a href="/photography" class="styledImage">
      {photography?.[0]?.image ? (
        <ResponsiveSanityImage
          source={photography[0].image}
          alt={photography[0].title}
          sourceWidth={photography[0].image.asset.metadata.dimensions.width}
          sourceHeight={photography[0].image.asset.metadata.dimensions.height}
          widths={[320, 480, 640, 800]}
          sizes="(max-width: 768px) calc(100vw - 5rem), 30vw"
          cropSquare
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/photography" class="styledLink">PHOTOGRAPHY</a>
    </div>
  </div>
</section>

<style>
  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .type {
    display: block;
    display: flex;
    flex-direction: column;
    width: 30%;
  }

  .type img,
  .image-placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

  .image-placeholder {
    background-color: var(--secondary-color);
  }

  .type > div {
    text-align: center;
    margin-top: 1rem;
  }

  @media screen and (max-width: 768px) {
    .container {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .type {
      width: 100%;
    }
  }
</style>
