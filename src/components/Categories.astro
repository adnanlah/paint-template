---
import { Image } from "astro:assets";
import { sanityClient } from "sanity:client";
import type { SanityDocument } from "@sanity/client";
import { urlFor } from "../scripts/helpers";

const QUERY1 = `*[
  _type == "painting"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const paintings = await sanityClient.fetch<SanityDocument[]>(QUERY1);

const QUERY2 = `*[
  _type == "collage"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const collages = await sanityClient.fetch<SanityDocument[]>(QUERY2);

const QUERY3 = `*[
  _type == "photography"
  && highlighted == true
]|order(year desc)[0..2]{_id, title, slug, highlighted, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const photography = await sanityClient.fetch<SanityDocument[]>(QUERY3);
---

<section class={"container"}>
  <div class="type">
    <a href="/paintings" class="styledImage">
      {paintings?.[0]?.image ? (
        <Image
          src={urlFor(paintings[0].image.asset.url)
            .width(600)
            .format("webp")
            .url()}
          width={600}
          height={Math.round(
            (paintings[0].image.asset.metadata.dimensions.height /
              paintings[0].image.asset.metadata.dimensions.width) *
              600,
          )}
          alt={paintings[0].title}
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/paintings" class="styledLink">PAINTING</a>
    </div>
  </div>
  <div class="type">
    <a href="/digital-collages" class="styledImage">
      {collages?.[0]?.image ? (
        <Image
          src={urlFor(collages[0].image.asset.url)
            .width(600)
            .format("webp")
            .url()}
          width={600}
          height={Math.round(
            (collages[0].image.asset.metadata.dimensions.height /
              collages[0].image.asset.metadata.dimensions.width) *
              600,
          )}
          alt={collages[0].title}
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/digital-collages" class="styledLink">DIGITAL COLLAGES</a>
    </div>
  </div>
  <div class="type">
    <a href="/photography" class="styledImage">
      {photography?.[0]?.image ? (
        <Image
          src={urlFor(photography[0].image.asset.url)
            .width(600)
            .format("webp")
            .url()}
          width={600}
          height={Math.round(
            (photography[0].image.asset.metadata.dimensions.height /
              photography[0].image.asset.metadata.dimensions.width) *
              600,
          )}
          alt={photography[0].title}
        />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </a>
    <div>
      <a href="/photography" class="styledLink">PHOTOGRAPHY</a>
    </div>
  </div>
</section>

<style>
  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    /* border: 1px solid blue; */
    /* height: 100%; */
    /* padding: 0 7.5rem; */
  }

  .type {
    display: block;
    display: flex;
    flex-direction: column;
    width: 30%;
  }

  .type img,
  .image-placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

  .image-placeholder {
    background-color: var(--secondary-color);
  }

  .type > div {
    text-align: center;
    margin-top: 1rem;
  }

  @media screen and (max-width: 768px) {
    .container {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .type {
      width: 100%;
    }
  }
</style>
