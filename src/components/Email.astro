---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const QUERY = `*[
  _type == "bio"
]|{_id, email, address, instagram, facebook, body, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const bio = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<div class={"container"}>
    <div class={"portfolio"}>PORTFOLIO</div>
    <div class={"name"}>EL BAHI BELKHEIRI</div>
    <div class={"email"}>
        <a href={"mailto:" + bio[0].email} class={"styledLink"}
            >{bio[0].email.split("@")[0]}<span class={"emailSpan"}
                >@{bio[0].email.split("@")[1]}</span
            ></a
        >
    </div>
</div>

<style>
    .container {
        display: flex;
        height: 100%;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1rem;
    }

    .portfolio {
        font-size: 2.5rem;
    }

    .name {
        font-size: 2.5rem;
        font-weight: bold;
    }

    .emailSpan {
        font-weight: bold;
    }
</style>
