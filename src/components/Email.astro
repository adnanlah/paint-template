---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";

const QUERY = `*[
  _type == "about"
]|{email}`;

const about = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<section class={"container"}>
    <h2 class={"portfolio"}>PORTFOLIO</h2>
    <h1 class={"name"}>EL BAHI BELKHEIRI</h1>
    <h3 class={"email"}>
        <a href={"mailto:" + about[0].email} class={"styledLink"}
            >{about[0].email.split("@")[0]}<span class={"emailSpan"}
                >@{about[0].email.split("@")[1]}</span
            ></a
        >
    </h3>
</section>

<style>
    .container {
        display: flex;
        height: 100%;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1rem;
    }

    .portfolio {
        font-size: 2.5rem;
        font-weight: normal;
    }

    .name {
        font-size: 2.5rem;
        font-weight: bold;
    }

    .email {
        font-weight: normal;
    }

    .emailSpan {
        font-weight: bold;
    }
</style>
