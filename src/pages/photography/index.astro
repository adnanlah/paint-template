---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { urlFor } from "../../scripts/helpers";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageNote from "../../components/PageNote.astro";
import Themes from "../../components/Themes.astro";

const QUERY = `*[
  _type == "photographyTheme"
  && defined(slug.current)
]|order(year desc){_id, title, slug, image{asset->{_id, url, metadata{dimensions}}}}`;

const ABOUT_QUERY = `*[
  _type == "about"
]|{photographyMessage}`;

const photographyThemes = await sanityClient.fetch<SanityDocument[]>(QUERY);
const about = await sanityClient.fetch<SanityDocument[]>(ABOUT_QUERY);

const themes = photographyThemes.map((theme) => {
    return {
        title: theme.title,
        url: `/photography/theme/${theme.slug.current}`,
        image: {
            url: urlFor(theme.image.asset.url).width(1000).format("webp").url(),
            height: theme.image.asset.metadata.dimensions.height,
            width: theme.image.asset.metadata.dimensions.width,
        },
    };
});
---

<Base title="PHOTOGRAPHY">
    <div>
        <Breadcrumbs
            links={[{ label: "ARTWORK", href: "/" }]}
            current="PHOTOGRAPHY"
        />
        {
            about[0].photographyMessage && (
                <PageNote note={about[0].photographyMessage} />
            )
        }
        <Themes themes={themes} />
    </div>
</Base>
