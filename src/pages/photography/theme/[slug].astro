---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import Body from "../../../components/Body.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "photographyTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "photography"
  && theme->slug.current == $slug
]|order(year desc){
  _id, 
  title, 
  slug, 
  year, 
  body,
  theme->{
    title,
    slug
  },
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const photography = await sanityClient.fetch<SanityDocument[]>(QUERY, {
    slug,
});

if (!photography) {
    return Astro.redirect("/404");
}
---

<Base title={photography[0].theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PHOTOGRAPHY", href: "/photography" },
            ]}
            current={photography[0].theme.title}
        />
        <div class="container">
            {
                photography.map((photography) => (
                    <ThemeImage
                        title={photography.title}
                        imageUrl={photography.image.asset.url}
                        url={`/photography/theme/${slug}/${photography.slug.current}`}
                        width={
                            photography.image.asset.metadata.dimensions.width
                        }
                        height={
                            photography.image.asset.metadata.dimensions.height
                        }
                    >
                        <div>
                            <b>Year:</b> {photography.year}
                        </div>
                        {photography.body && <Body value={photography.body} />}
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
</style>
