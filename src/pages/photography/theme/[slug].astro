---
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import Body from "../../../components/Body.astro";
import {
    decodeSlug,
    encodeSlug,
    type ArtworkListDocument,
    type SlugParam,
} from "../../../scripts/helpers";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch<SlugParam[]>(`
    *[_type == "photographyTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s) => ({
        params: { slug: encodeSlug(s.slug) },
    }));
}

const slug = Astro.params.slug ? decodeSlug(Astro.params.slug) : undefined;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "photography"
  && theme->slug.current == $slug
]|order(order asc){
  _id, 
  title, 
  slug, 
  order,
  year, 
  body,
  theme->{
    title,
    slug
  },
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const photography = await sanityClient.fetch<ArtworkListDocument[]>(QUERY, {
    slug,
});

if (!photography || photography.length === 0) {
    return Astro.redirect("/404");
}
---

<Base title={photography[0].theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PHOTOGRAPHY", href: "/photography" },
            ]}
            current={photography[0].theme.title}
        />
        <div class="container">
            {
                photography.map((photography, index) => (
                    <ThemeImage
                        title={photography.title}
                        image={photography.image}
                        url={`/photography/theme/${encodeSlug(slug)}/${encodeSlug(photography.slug.current)}`}
                        width={
                            photography.image.asset.metadata.dimensions.width
                        }
                        height={
                            photography.image.asset.metadata.dimensions.height
                        }
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                    >
                        <div>
                            <b>Year:</b> {photography.year}
                        </div>
                        <div class="body">
                            {photography.body && (
                                <Body value={photography.body} />
                            )}
                        </div>
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    @media screen and (max-width: 768px) {
        .body {
            display: none;
        }
    }
</style>
