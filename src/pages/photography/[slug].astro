---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { PortableText } from "astro-portabletext";
import { Image } from "astro:assets";
import { urlFor } from "../../scripts/helpers";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "photography" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "photography" &&
  slug.current == $slug
][0]{
  _id,
  title,
  slug,
  year,
  body,
  image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }
}`;

const photo = await sanityClient.fetch<SanityDocument>(QUERY, {
    slug,
});

if (!photo) {
    return Astro.redirect("/404");
}
---

<Base>
    <main>
        <h1 class="title">
            <a href="/photography" class="styledLink">Photography</a>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="size-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="m5.25 4.5 7.5 7.5-7.5 7.5m6-15 7.5 7.5-7.5 7.5"></path>
            </svg>

            <div>
                {photo.title}
            </div>
        </h1>
        <div class="image-container">
            <Image
                src={urlFor(photo.image.asset.url)
                    .width(1200)
                    .format("webp")
                    .url()}
                alt={photo.title}
                width={1200}
                height={Math.round(
                    (photo.image.asset.metadata.dimensions.height /
                        photo.image.asset.metadata.dimensions.width) *
                        1200,
                )}
                class="image"
            />
        </div>

        <div class={"details"}>
            <h2>{photo.title}</h2>
            <div class="info">
                {photo.year}
            </div>
            <div class="body">
                <PortableText value={photo.body} />
            </div>
        </div>
    </main>
</Base>

<style>
    .container {
        padding: 0 7.5rem;
    }

    .info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .title svg {
        width: 1rem;
        height: 1rem;
    }

    .image-container {
        display: flex;
        justify-content: center;
        margin-top: 2.5rem;
    }

    .image {
        width: auto;
        height: 80vh;
    }

    .details {
        margin: 2.5rem auto 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        text-align: center;
        width: 33%;
    }

    .details > .body {
        text-align: left;
        line-height: 1.5;
    }
</style>
