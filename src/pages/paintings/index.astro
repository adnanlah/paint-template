---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { urlFor } from "../../scripts/helpers";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const QUERY = `*[
  _type == "paintingTheme"
  && defined(slug.current)
]|order(year desc){_id, title, slug, image{asset->{_id, url, metadata{dimensions}}}}`;

const ABOUT_QUERY = `*[
  _type == "about"
]|{paintingMessage}`;

const paintingThemes = await sanityClient.fetch<SanityDocument[]>(QUERY);
const about = await sanityClient.fetch<SanityDocument[]>(ABOUT_QUERY);
---

<Base title="PAINTINGS">
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PAINTINGS", href: "/paintings" },
            ]}
        />
        {
            about[0].paintingMessage && (
                <p class="page-note">{about[0].paintingMessage}</p>
            )
        }
        <div class={"themes"}>
            {
                paintingThemes.map((theme) => (
                    <div class:list={["theme"]}>
                        <a
                            href={`/paintings/theme/${theme.slug.current}`}
                            class:list={["image-container", "styledImage"]}
                        >
                            <Image
                                src={urlFor(theme.image.asset.url)
                                    .width(1000)
                                    .format("webp")
                                    .url()}
                                alt={theme.title}
                                width={1000}
                                height={Math.round(
                                    (theme.image.asset.metadata.dimensions
                                        .height /
                                        theme.image.asset.metadata.dimensions
                                            .width) *
                                        1000,
                                )}
                            />
                        </a>

                        <div class={"info"}>
                            <a
                                href={`/paintings/theme/${theme.slug.current}`}
                                class={"styledLink"}
                            >
                                {theme.title}
                            </a>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .page-note {
        margin-top: 1rem;
    }

    .themes {
        margin-top: 2.5rem;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5rem;
    }

    .theme {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .theme .image-container {
        display: block;
        width: 100%;
    }

    .theme .image-container img {
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-fit: cover;
    }

    .theme .info {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        text-transform: uppercase;
    }
</style>
