---
import { sanityClient } from "sanity:client";
import MainButton from "../../../../components/MainButton.astro";
import InquireModal from "../../../../components/InquireModal.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import Base from "../../../../layouts/Base.astro";
import PaintingDetails from "../../../../components/PaintingDetails.astro";
import Body from "../../../../components/Body.astro";
import Artwork from "../../../../components/Artwork.astro";
import {
  decodeSlug,
  encodeSlug,
  type NestedSlugParam,
  type PaintingDetailDocument,
} from "../../../../scripts/helpers";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<NestedSlugParam[]>(`
    *[_type == "painting" && defined(slug.current)]{
      "slug": slug.current,
      "themeslug": theme->slug.current
    }
  `);

  return slugs
    .filter((s) => s.slug && s.themeslug)
    .map((s) => ({
      params: {
        paintingslug: encodeSlug(s.slug),
        themeslug: encodeSlug(s.themeslug),
      },
    }));
}

const paintingslug = Astro.params.paintingslug
  ? decodeSlug(Astro.params.paintingslug)
  : undefined;
const themeslug = Astro.params.themeslug
  ? decodeSlug(Astro.params.themeslug)
  : undefined;

if (!paintingslug || !themeslug) {
  throw new Error("Missing slugs params");
}

const QUERY = `*[
  _type == "painting" &&
  slug.current == $paintingslug
][0]{
  _id,
  title,
  slug,
  year,
  width,
  height,
  medium,
  body,
  available,
  theme->{
    title,
    slug
  },
  image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }
}`;

const painting = await sanityClient.fetch<PaintingDetailDocument>(QUERY, {
  paintingslug,
});

if (!painting) {
  return Astro.redirect("/404");
}
---

<Base title={painting.title}>
  <InquireModal id="my-modal" slug={paintingslug} />
  <Breadcrumbs
    links={[
      { label: "ARTWORK", href: "/" },
      { label: "PAINTINGS", href: "/paintings" },
      {
        label: painting.theme.title,
        href: `/paintings/theme/${encodeSlug(painting.theme.slug.current)}`,
      },
    ]}
    current={painting.title}
  />
  <div class="container">
    <Artwork
      title={painting.title}
      image={painting.image}
      width={painting.image.asset.metadata.dimensions.width}
      height={painting.image.asset.metadata.dimensions.height}
    >
      <PaintingDetails
        painting={{
          year: painting.year,
          width: painting.width,
          height: painting.height,
          medium: painting.medium,
        }}
      />
      {painting.body && <Body value={painting.body} />}

      {
        !painting.available && (
          <div class="not-available">
            <div>Not available!</div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.182 16.318A4.486 4.486 0 0 0 12.016 15a4.486 4.486 0 0 0-3.198 1.318M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z"
              />
            </svg>
          </div>
        )
      }
      {
        painting.available && (
          <MainButton id="open-modal" data-slug={paintingslug}>
            Inquire
          </MainButton>
        )
      }
    </Artwork>
  </div>
</Base>

<style>
  .container {
    margin-top: 2.5rem;
  }

  .not-available {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-style: italic;
  }

  .not-available svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
