---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import Body from "../../../components/Body.astro";
import PaintingDetails from "../../../components/PaintingDetails.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "paintingTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "painting"
  && theme->slug.current == $slug
]|order(order asc){
  _id, 
  title, 
  slug, 
  order,
  year, 
  width, 
  height, 
  medium,
  body,
  theme->{
    title,
    slug
  },
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const paintings = await sanityClient.fetch<SanityDocument[]>(QUERY, {
    slug,
});

if (!paintings || paintings.length === 0) {
    return Astro.redirect("/404");
}
---

<Base title={paintings[0].theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PAINTINGS", href: "/paintings" },
            ]}
            current={paintings[0].theme.title}
        />
        <div class="container">
            {
                paintings.map((painting) => (
                    <ThemeImage
                        title={painting.title}
                        imageUrl={painting.image.asset.url}
                        url={`/paintings/theme/${slug}/${painting.slug.current}`}
                        width={painting.image.asset.metadata.dimensions.width}
                        height={painting.image.asset.metadata.dimensions.height}
                    >
                        <PaintingDetails
                            painting={{
                                year: painting.year,
                                width: painting.width,
                                height: painting.height,
                                medium: painting.medium,
                            }}
                        />
                        <div class="body">
                            {painting.body && <Body value={painting.body} />}
                        </div>
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    @media screen and (max-width: 768px) {
        .body {
            display: none;
        }
    }
</style>
