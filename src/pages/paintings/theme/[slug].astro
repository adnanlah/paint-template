---
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import Body from "../../../components/Body.astro";
import PaintingDetails from "../../../components/PaintingDetails.astro";
import {
    decodeSlug,
    encodeSlug,
    type PaintingListDocument,
    type SlugParam,
} from "../../../scripts/helpers";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch<SlugParam[]>(`
    *[_type == "paintingTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s) => ({
        params: { slug: encodeSlug(s.slug) },
    }));
}

const slug = Astro.params.slug ? decodeSlug(Astro.params.slug) : undefined;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "painting"
  && theme->slug.current == $slug
]|order(order asc){
  _id, 
  title, 
  slug, 
  order,
  year, 
  width, 
  height, 
  medium,
  body,
  theme->{
    title,
    slug
  },
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const paintings = await sanityClient.fetch<PaintingListDocument[]>(QUERY, {
    slug,
});

if (!paintings || paintings.length === 0) {
    return Astro.redirect("/404");
}
---

<Base title={paintings[0].theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PAINTINGS", href: "/paintings" },
            ]}
            current={paintings[0].theme.title}
        />
        <div class="container">
            {
                paintings.map((painting, index) => (
                    <ThemeImage
                        title={painting.title}
                        image={painting.image}
                        url={`/paintings/theme/${encodeSlug(slug)}/${encodeSlug(painting.slug.current)}`}
                        width={painting.image.asset.metadata.dimensions.width}
                        height={painting.image.asset.metadata.dimensions.height}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                    >
                        <PaintingDetails
                            painting={{
                                year: painting.year,
                                width: painting.width,
                                height: painting.height,
                                medium: painting.medium,
                            }}
                        />
                        <div class="body">
                            {painting.body && <Body value={painting.body} />}
                        </div>
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    @media screen and (max-width: 768px) {
        .body {
            display: none;
        }
    }
</style>
