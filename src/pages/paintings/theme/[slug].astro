---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import { PortableText } from "astro-portabletext";
import Dimensions from "../../../components/Dimensions.astro";
import Body from "../../../components/Body.astro";
import PaintingDetails from "../../../components/PaintingDetails.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "paintingTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const THEME_QUERY = `*[
  _type == "paintingTheme"
  && slug.current == $slug
][0]{
  _id,
  title,
  slug
}`;

const QUERY = `*[
  _type == "painting"
  && theme->slug.current == $slug
]|order(year desc){
  _id, 
  title, 
  slug, 
  year, 
  width, 
  height, 
  medium,
  body,
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const paintings = await sanityClient.fetch<SanityDocument[]>(QUERY, {
    slug,
});

if (!paintings) {
    return Astro.redirect("/404");
}

const theme = await sanityClient.fetch<SanityDocument>(THEME_QUERY, {
    slug,
});

if (!theme) {
    return Astro.redirect("/404");
}
---

<Base title={theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PAINTINGS", href: "/paintings" },
            ]}
            current={theme.title}
        />
        <div class="container">
            {
                paintings.map((painting) => (
                    <ThemeImage
                        title={painting.title}
                        imageUrl={painting.image.asset.url}
                        url={`/paintings/theme/${slug}/${painting.slug.current}`}
                        width={painting.image.asset.metadata.dimensions.width}
                        height={painting.image.asset.metadata.dimensions.height}
                    >
                        <PaintingDetails
                            painting={{
                                year: painting.year,
                                width: painting.width,
                                height: painting.height,
                                medium: painting.medium,
                            }}
                        />
                        <Body value={painting.body} />
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }
</style>
