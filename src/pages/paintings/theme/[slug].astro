---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";
import { Image } from "astro:assets";
import { urlFor } from "../../../scripts/helpers";
import { PortableText } from "astro-portabletext";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "paintingTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const THEME_QUERY = `*[
  _type == "paintingTheme"
  && slug.current == $slug
][0]{
  _id,
  title,
  slug
}`;

const QUERY = `*[
  _type == "painting"
  && theme->slug.current == $slug
]|order(year desc){
  _id, 
  title, 
  slug, 
  year, 
  width, 
  height, 
  medium,
  body,
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const paintings = await sanityClient.fetch<SanityDocument[]>(QUERY, {
    slug,
});

if (!paintings) {
    return Astro.redirect("/404");
}

const theme = await sanityClient.fetch<SanityDocument>(THEME_QUERY, {
    slug,
});

if (!theme) {
    return Astro.redirect("/404");
}
---

<Base>
    <div class={"container"}>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "PAINTINGS", href: "/paintings" },
            ]}
            current={theme.title}
        />
        <div class={"paintings"}>
            {
                paintings.map((painting) => (
                    <div class={"painting"}>
                        <a
                            href={`/paintings/theme/${slug}/${painting.slug.current}`}
                            class="styledImage"
                        >
                            <Image
                                src={urlFor(painting.image.asset.url)
                                    .width(1000)
                                    .format("webp")
                                    .url()}
                                alt={painting.title}
                                width={1000}
                                height={Math.round(
                                    (painting.image.asset.metadata.dimensions
                                        .height /
                                        painting.image.asset.metadata.dimensions
                                            .width) *
                                        1000,
                                )}
                                class="image"
                            />
                        </a>
                        <div class="info">
                            <a
                                href={`/paintings/theme/${slug}/${painting.slug.current}`}
                                class="styledLink"
                            >
                                <h2>{painting.title}</h2>
                            </a>
                            <div class="details">
                                {painting.year} •{" "}
                                <div class="dimensions">
                                    {painting.width}mm
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="2"
                                        stroke="currentColor"
                                        class="size-6"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M6 18 18 6M6 6l12 12"
                                        />
                                    </svg>
                                    {painting.height}mm
                                </div>{" "}
                                • {painting.medium}
                            </div>
                            <div class="body">
                                <PortableText value={painting.body} />
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .paintings {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 5rem;
    }

    .details,
    .dimensions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dimensions svg {
        width: 0.75rem;
        height: 0.75rem;
    }

    .painting {
        width: 100%;
        display: grid;
        grid-template-columns: 40% 1fr;
        gap: 2rem;
    }

    .painting .image {
        width: 100%;
        height: auto;
    }

    .painting .info {
        display: flex;
        flex-direction: column;
        justify-self: stretch;
        gap: 0.5rem;
    }
</style>
