---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="404, Page not found!">
    <div class={"container"}>
        <div class={"headerContainer"}>
            <Header />
        </div>
        <div class={"content"}>
            <h1>404</h1>
            <p>
                Page not found! <a href="/" class={"styledLink"}
                    ><i>Go back to home page</i></a
                >
            </p>
        </div>
        <div></div>
    </div>
</Layout>

<style>
    .container {
        height: 100vh;
        display: grid;
        grid-template-rows: 1fr auto 1fr;
    }

    .headerContainer {
        justify-self: flex-start;
        width: 100%;
    }

    .content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    h1 {
        font-size: 10rem;
        font-weight: 700;
    }

    p {
        font-weight: 700;
    }
</style>
