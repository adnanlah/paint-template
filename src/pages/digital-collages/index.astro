---
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PageNote from "../../components/PageNote.astro";
import Themes from "../../components/Themes.astro";
import { encodeSlug } from "../../scripts/helpers";
import type {
    SanityImageWithMetadata,
    ThemeCard,
} from "../../scripts/helpers";

interface ThemeDocument {
    title: string;
    slug: { current: string };
    image: SanityImageWithMetadata;
}

interface AboutMessageDocument {
    collageMessage?: string;
}

const QUERY = `*[
  _type == "collageTheme"
  && defined(slug.current)
]|order(year desc){_id, title, slug, image{asset->{_id, url, metadata{dimensions}}, crop, hotspot}}`;

const ABOUT_QUERY = `*[
  _type == "about"
]|{collageMessage}`;

const collageThemes = await sanityClient.fetch<ThemeDocument[]>(QUERY);
const about = await sanityClient.fetch<AboutMessageDocument[]>(ABOUT_QUERY);

const themes: ThemeCard[] = collageThemes.map((theme) => {
    return {
        title: theme.title,
        url: `/digital-collages/theme/${encodeSlug(theme.slug.current)}`,
        image: {
            source: theme.image,
            height: theme.image.asset.metadata.dimensions.height,
            width: theme.image.asset.metadata.dimensions.width,
        },
    };
});
---

<Base title="DIGITAL COLLAGES">
    <div>
        <Breadcrumbs
            links={[{ label: "ARTWORK", href: "/" }]}
            current="DIGITAL COLLAGES"
        />
        {about[0].collageMessage && <PageNote note={about[0].collageMessage} />}
        <Themes themes={themes} />
    </div>
</Base>
