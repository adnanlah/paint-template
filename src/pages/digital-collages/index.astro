---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { PortableText } from "astro-portabletext";
import { Image } from "astro:assets";
import { urlFor } from "../../scripts/helpers";

const QUERY = `*[
  _type == "collage"
  && defined(slug.current)
]|order(year desc){_id, title, slug, year, body, image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const collages = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<Base>
    <div>
        <h1>Digital Collages</h1>
        <div class={"photos"}>
            {
                collages.map((photo, idx) => (
                    <div
                        class:list={["photo", { photoReversed: idx % 2 !== 0 }]}
                    >
                        <a
                            href={`/digital-collages/${photo.slug.current}`}
                            class:list={[
                                "clickableImage",
                                "imageLink",
                                { right: idx % 2 !== 0, left: idx % 2 === 0 },
                            ]}
                        >
                            <Image
                                src={urlFor(photo.image.asset.url)
                                    .width(1000)
                                    .url()}
                                alt={photo.title}
                                width={1000}
                                height={Math.round(
                                    (photo.image.asset.metadata.dimensions
                                        .height /
                                        photo.image.asset.metadata.dimensions
                                            .width) *
                                        1000,
                                )}
                                class={"image"}
                            />
                        </a>

                        <div class={"info"}>
                            <div>
                                <a
                                    href={`/digital-collages/${photo.slug.current}`}
                                    class={"styledLink"}
                                >
                                    <h2>{photo.title}</h2>
                                </a>
                            </div>
                            <div class={"details"}>
                                <div class={"description"}>
                                    {Array.isArray(photo.body) && (
                                        <PortableText value={photo.body} />
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .photos {
        display: flex;
        flex-direction: column;
        margin-top: 3.5rem;
    }

    .photo {
        height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: center;
    }

    .photo h2 {
        display: inline-block;
    }

    .photoReversed > :first-child {
        order: 1;
    }

    .photoReversed > :last-child {
        order: -1;
    }

    .photoReversed .info {
        justify-self: flex-start;
    }

    .photoReversed .info {
        justify-self: flex-end;
    }

    .photoReversed .description {
        text-align: right;
    }

    .photo .imageLink {
        justify-self: flex-end;
        display: block;
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .photo .image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .photo .info {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .photo .details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
</style>
