---
import { sanityClient } from "sanity:client";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import Base from "../../../../layouts/Base.astro";
import Body from "../../../../components/Body.astro";
import Artwork from "../../../../components/Artwork.astro";
import {
  decodeSlug,
  encodeSlug,
  type ArtworkDetailDocument,
  type NestedSlugParam,
} from "../../../../scripts/helpers";

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<NestedSlugParam[]>(`
    *[_type == "collage" && defined(slug.current)]{
      "slug": slug.current,
      "themeslug": theme->slug.current
    }
  `);

  return slugs
    .filter((s) => s.slug && s.themeslug)
    .map((s) => ({
      params: {
        collageslug: encodeSlug(s.slug),
        themeslug: encodeSlug(s.themeslug),
      },
    }));
}

const collageslug = Astro.params.collageslug
  ? decodeSlug(Astro.params.collageslug)
  : undefined;
const themeslug = Astro.params.themeslug
  ? decodeSlug(Astro.params.themeslug)
  : undefined;

if (!collageslug || !themeslug) {
  throw new Error("Missing slugs params");
}

const QUERY = `*[
  _type == "collage" &&
  slug.current == $collageslug
][0]{
  _id,
  title,
  slug,
  year,
  body,
  theme->{
    title,
    slug
  },
  image{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    }
  }
}`;

const collage = await sanityClient.fetch<ArtworkDetailDocument>(QUERY, {
  collageslug,
});

if (!collage) {
  return Astro.redirect("/404");
}
---

<Base title={collage.title}>
  <Breadcrumbs
    links={[
      { label: "ARTWORK", href: "/" },
      { label: "DIGITAL COLLAGES", href: "/digital-collages" },
      {
        label: collage.theme.title,
        href: `/digital-collages/theme/${encodeSlug(collage.theme.slug.current)}`,
      },
    ]}
    current={collage.title}
  />
  <div class="container">
    <Artwork
      title={collage.title}
      image={collage.image}
      width={collage.image.asset.metadata.dimensions.width}
      height={collage.image.asset.metadata.dimensions.height}
    >
      <div>Year: {collage.year}</div>
      {collage.body && <Body value={collage.body} />}
    </Artwork>
  </div>
</Base>

<style>
  .container {
    margin-top: 2.5rem;
  }
</style>
