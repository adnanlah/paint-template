---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../../layouts/Base.astro";

import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ThemeImage from "../../../components/ThemeImage.astro";
import Body from "../../../components/Body.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(`
    *[_type == "collageTheme" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

    return slugs.map((s: { slug: any }) => ({
        params: { slug: s.slug },
    }));
}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing slug param");
}

const QUERY = `*[
  _type == "collage"
  && theme->slug.current == $slug
]|order(year desc){
  _id, 
  title, 
  slug, 
  year, 
  body,
  theme->{
    title,
    slug
  },
  image{asset->{_id, url, metadata{dimensions}}}}
`;

const digitalCollages = await sanityClient.fetch<SanityDocument[]>(QUERY, {
    slug,
});

if (!digitalCollages) {
    return Astro.redirect("/404");
}
---

<Base title={digitalCollages[0].theme.title}>
    <div>
        <Breadcrumbs
            links={[
                { label: "ARTWORK", href: "/" },
                { label: "DIGITAL COLLAGES", href: "/digital-collages" },
            ]}
            current={digitalCollages[0].theme.title}
        />
        <div class="container">
            {
                digitalCollages.map((digitalCollage) => (
                    <ThemeImage
                        title={digitalCollage.title}
                        imageUrl={digitalCollage.image.asset.url}
                        url={`/digital-collages/theme/${slug}/${digitalCollage.slug.current}`}
                        width={
                            digitalCollage.image.asset.metadata.dimensions.width
                        }
                        height={
                            digitalCollage.image.asset.metadata.dimensions
                                .height
                        }
                    >
                        <div>
                            <b>Year:</b> {digitalCollage.year}
                        </div>
                        <div class="body">
                            {digitalCollage.body && (
                                <Body value={digitalCollage.body} />
                            )}
                        </div>
                    </ThemeImage>
                ))
            }
        </div>
    </div>
</Base>

<style>
    .container {
        margin-top: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    @media screen and (max-width: 768px) {
        .body {
            display: none;
        }
    }
</style>
