---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import HeroImage from "../components/HeroImage.astro";
import Email from "../components/Email.astro";
import About from "../components/About.astro";
import Paintings from "../components/Paintings.astro";
import Collage from "../components/Collage.astro";
import Photography from "../components/Photography.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<div class={"hero"}>
		<Header />
		<div class={"gallery"}>
			<HeroImage />
			<Email />
		</div>
	</div>
	<About />
	<Paintings />
	<Collage />
	<Photography />
	<Footer />
</Layout>

<style>
	.hero {
		height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.gallery {
		flex: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.gallery > * {
		flex: 1;
	}
</style>
