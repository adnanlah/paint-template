---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { urlFor } from "../../scripts/helpers";
import ContactForm from "../../components/ContactForm.astro";
import Title from "../../components/Title.astro";
import Socials from "../../components/Socials.astro";

const QUERY = `*[
  _type == "about"
]|{_id, email, instagram, facebook, linkedin, contactParagraph1, contactParagraph2, contactParagraph3, phone, behance, contactImage{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    }
  }}`;

const about = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<Base title="Contact">
    <Title content="CONTACT ME" />
    <section class="container">
        <Image
            src={urlFor(about[0].contactImage.asset.url)
                .width(1200)
                .format("webp")
                .url()}
            width={1200}
            height={Math.round(
                (about[0].contactImage.asset.metadata.dimensions.height /
                    about[0].contactImage.asset.metadata.dimensions.width) *
                    1200,
            )}
            alt="Contact me image"
            class="image"
        />
        <div class="body">
            <p>{about[0]?.contactParagraph1}</p>
            <a href={`mailto:${about[0].email}`}>
                {about[0].email.split("@")[0]}<b
                    >@{about[0].email.split("@")[1]}</b
                >
            </a>
            <p>{about[0]?.contactParagraph2}</p>
            <Socials
                instagram={about[0]?.instagram}
                facebook={about[0]?.facebook}
                linkedin={about[0]?.linkedin}
                behance={about[0]?.behance}
                phone={about[0]?.phone}
            />
            <p>{about[0]?.contactParagraph3}</p>
            <ContactForm />
        </div>
    </section>
</Base>

<style>
    .container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-top: 2.5rem;
    }

    .image {
        width: 100%;
        height: auto;
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    @media screen and (max-width: 1000px) {
        .container {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }
</style>
