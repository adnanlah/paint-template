---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import { urlFor } from "../../scripts/helpers";
import ContactForm from "../../components/ContactForm.astro";

const QUERY = `*[
  _type == "about"
]|{_id, email, address, instagram, facebook, contactImage{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    },
    crop,
    hotspot
  }}`;

const about = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<Base>
    <h1>CONTACT ME</h1>
    <section class="container">
        <Image
            src={urlFor(about[0].contactImage.asset.url)
                .width(800)
                .format("webp")
                .url()}
            width={800}
            height={Math.round(
                (about[0].contactImage.asset.metadata.dimensions.height /
                    about[0].contactImage.asset.metadata.dimensions.width) *
                    800,
            )}
            alt="About me image"
            class="image"
        />
        <div class="body">
            <p>You can reach me at:</p>
            <p>{about[0].email}</p>
            <p>+213 666 666 666</p>
            <p>
                LinkedIn: <a href={about[0].linkedin}></a>
            </p>
            <p>
                Instagram: <a href={about[0].instagram}></a>
            </p>
            <p>
                Facebook: <a href={about[0].facebook}></a>
            </p>

            <ContactForm />
        </div>
    </section>
</Base>

<style>
    .container {
        width: 75%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: start;
        margin: 2.5rem auto 0 auto;
    }

    .image {
        width: 100%;
        height: auto;
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    .downloads {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-grow: 1;
    }
</style>
