---
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import ContactForm from "../../components/ContactForm.astro";
import Title from "../../components/Title.astro";
import Socials from "../../components/Socials.astro";
import ResponsiveSanityImage from "../../components/ResponsiveSanityImage.astro";
import type { ContactDocument } from "../../scripts/helpers";

const QUERY = `*[
  _type == "about"
]|{_id, email, instagram, facebook, linkedin, contactParagraph1, contactParagraph2, contactParagraph3, phone, behance, contactImage{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    }
  }}`;

const about = await sanityClient.fetch<ContactDocument[]>(QUERY);
const contact = about[0];
const [emailName, emailDomain] = contact.email.split("@");
---

<Base title="Contact" mainClass="compact-page">
    <Title content="CONTACT ME" />
    <section class="container">
        <div class="image-frame">
            <ResponsiveSanityImage
                source={contact.contactImage}
                alt="Contact me image"
                sourceWidth={contact.contactImage.asset.metadata.dimensions.width}
                sourceHeight={contact.contactImage.asset.metadata.dimensions.height}
                widths={[320, 480, 640, 800, 960, 1200]}
                sizes="(max-width: 1000px) calc(100vw - 5rem), 50vw"
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <div class="body">
            <p>{contact.contactParagraph1}</p>
            <a href={`mailto:${contact.email}`}>
                {emailName}<b>@{emailDomain}</b>
            </a>
            <p>{contact.contactParagraph2}</p>
            <Socials
                instagram={contact.instagram}
                facebook={contact.facebook}
                linkedin={contact.linkedin}
                behance={contact.behance}
                phone={contact.phone}
            />
            <p>{contact.contactParagraph3}</p>
            <ContactForm />
        </div>
    </section>
</Base>

<style>
    .container {
        width: 100%;
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2.5rem;
        align-items: start;
        margin-top: 2.5rem;
    }

    .image-frame {
        width: 100%;
        min-width: 0;
        max-height: 100%;
    }

    .image-frame :global(img) {
        max-height: 100%;
        object-fit: contain;
        object-position: left top;
    }

    .body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    @media screen and (max-width: 1000px) {
        .container {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .image-frame {
            max-height: none;
        }
    }
</style>
