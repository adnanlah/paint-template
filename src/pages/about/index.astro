---
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import Download from "../../components/Download.astro";
import Title from "../../components/Title.astro";
import Body from "../../components/Body.astro";
import ResponsiveSanityImage from "../../components/ResponsiveSanityImage.astro";
import type { SanityImageWithMetadata } from "../../scripts/helpers";
import type { TypedObject } from "@portabletext/types";

interface CollectionDownload {
    name: string;
    file: {
        asset: {
            url: string;
            originalFilename: string;
        };
    };
}

interface AboutDocument {
    aboutText: TypedObject | TypedObject[];
    aboutImage: SanityImageWithMetadata;
    collections?: CollectionDownload[];
}

const QUERY = `*[
  _type == "about"
]|{_id, email, address, instagram, facebook, aboutText, aboutImage{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    }
  }, collections[]->{
    name,
    file{
      asset->{
        url,
        originalFilename
      }
    }
  }}`;

const about = await sanityClient.fetch<AboutDocument[]>(QUERY);
---

<Base title="About" mainClass="compact-page">
    <Title content="ABOUT ME" />
    <section class="container">
        <div class="image-frame">
            <ResponsiveSanityImage
                source={about[0].aboutImage}
                alt="About image"
                sourceWidth={about[0].aboutImage.asset.metadata.dimensions.width}
                sourceHeight={about[0].aboutImage.asset.metadata.dimensions.height}
                widths={[320, 480, 640, 800, 960, 1200]}
                sizes="(max-width: 1000px) calc(100vw - 5rem), 50vw"
                loading="eager"
                fetchpriority="high"
            />
        </div>
        <div class="content">
            <Body value={about[0].aboutText} />

            <div class="downloads">
                Collections: 
                {about[0].collections?.map((collection) => (
                    <Download
                        href={collection.file.asset.url}
                        download={collection.file.asset.originalFilename}
                        text={collection.name}
                    />
                ))}
            </div>
        </div>
    </section>
</Base>

<style>
    .container {
        width: 100%;
        flex: 1;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2.5rem;
        align-items: end;
        margin-top: 2.5rem;
    }

    .image-frame {
        width: 100%;
        min-width: 0;
        max-height: 100%;
    }

    .image-frame :global(img) {
        max-height: 100%;
        object-fit: contain;
        object-position: left bottom;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    .downloads {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-grow: 1;
    }

    @media screen and (max-width: 1000px) {
        .container {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .image-frame {
            max-height: none;
        }
    }
</style>
