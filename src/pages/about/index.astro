---
import type { SanityDocument } from "@sanity/client";
import { sanityClient } from "sanity:client";
import Base from "../../layouts/Base.astro";
import MyPortableText from "../../components/Body.astro";
import { Image } from "astro:assets";
import Download from "../../components/Download.astro";
import Title from "../../components/Title.astro";
import { urlFor } from "../../scripts/helpers";
import Body from "../../components/Body.astro";

const QUERY = `*[
  _type == "about"
]|{_id, email, address, instagram, facebook, aboutText, aboutImage{
    asset->{
      _id,
      url,
      metadata{
        dimensions
      }
    }
  }, collections[]->{
    name,
    file{
      asset->{
        url,
        originalFilename
      }
    }
  }}`;

const about = await sanityClient.fetch<SanityDocument[]>(QUERY);
---

<Base title="About">
    <Title content="ABOUT ME" />
    <section class="container">
        <Image
            src={urlFor(about[0].aboutImage.asset.url)
                .width(1200)
                .format("webp")
                .url()}
            width={1200}
            height={Math.round(
                (about[0].aboutImage.asset.metadata.dimensions.height /
                    about[0].aboutImage.asset.metadata.dimensions.width) *
                    1200,
            )}
            alt="About image"
            class="image"
        />
        <div class="content">
            <Body value={about[0].aboutText} />

            <div class="downloads">
                Collections: 
                {about[0].collections?.map((collection: any) => (
                    <Download
                        href={collection.file.asset.url}
                        download={collection.file.asset.originalFilename}
                        text={collection.name}
                    />
                ))}
            </div>
        </div>
    </section>
</Base>

<style>
    .container {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem;
        align-items: start;
        margin-top: 2.5rem;
    }

    .image {
        width: 100%;
        height: auto;
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.5;
    }

    .downloads {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-grow: 1;
    }

    @media screen and (max-width: 1000px) {
        .container {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }
</style>
